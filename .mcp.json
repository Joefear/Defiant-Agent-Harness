{
  "mcpServers": {
    "defiant-filesystem": {
      "type": "stdio",
      "command": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "scripts\\defiant_mcp.cmd",
        "--workdir",
        ".dah-copilot-mcp",
        "--workspace-root",
        "examples/vscode_agent/workspace",
        "--user",
        "copilot-cli-operator",
        "--workspace",
        "copilot-cli-mcp-proof",
        "mcp-proxy",
        "--config",
        "examples/filesystem/mcp-proxy.yaml",
        "--runner",
        "copilot-cli-mcp",
        "--",
        "cmd",
        "/d",
        "/s",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "examples/vscode_agent/workspace"
      ],
      "tools": [
        "*"
      ],
      "cwd": ".",
      "env": {
        "PYTHONPATH": "src",
        "PYTHONUTF8": "1",
        "NPM_CONFIG_CACHE": ".npm-cache"
      }
    }
  }
}
