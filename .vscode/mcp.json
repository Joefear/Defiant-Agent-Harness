{
  "servers": {
    "defiant-filesystem": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "defiant_agent_harness.cli.main",
        "--workdir",
        "${workspaceFolder}/.dah-vscode",
        "--workspace-root",
        "${workspaceFolder}/examples/vscode_agent/workspace",
        "--user",
        "vscode-operator",
        "--workspace",
        "vscode-agent-proof",
        "mcp-proxy",
        "--config",
        "${workspaceFolder}/examples/filesystem/mcp-proxy.yaml",
        "--runner",
        "vscode-copilot",
        "--",
        "cmd",
        "/d",
        "/s",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "${workspaceFolder}/examples/vscode_agent/workspace"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "PYTHONUTF8": "1",
        "NPM_CONFIG_CACHE": "${workspaceFolder}/.npm-cache"
      }
    }
  }
}
